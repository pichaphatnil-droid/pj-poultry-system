# ใช้ได้ทั้งฝั่งหน้าเว็บและเซิร์ฟเวอร์
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ฝั่งเซิร์ฟเวอร์เท่านั้น — ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้ามเผยแพร่
# Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ข้อความสุ่มยาวอย่างน้อย 32 ตัวอักษร ใช้ลงลายเซ็น cookie การเข้าระบบ
# สร้างได้ด้วยคำสั่ง: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
